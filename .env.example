# Copier ce fichier en `.env.local` (ignoré par git) et renseigner les valeurs.

# Clé secrète Stripe — tableau de bord > Développeurs > Clés API.
# Utiliser sk_test_... tant que le site n'est pas en production.
# Ne jamais préfixer cette clé par NEXT_PUBLIC_ : elle serait exposée au navigateur.
STRIPE_SECRET_KEY=sk_test_remplacer

# Secret de signature du webhook — indispensable pour vérifier que les
# événements viennent bien de Stripe.
# En local : `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# affiche un secret whsec_... à recopier ici.
# En production : Tableau de bord > Développeurs > Webhooks > votre endpoint.
STRIPE_WEBHOOK_SECRET=whsec_remplacer

# Origine publique du site, utilisée pour les URL de retour Stripe.
# En développement : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
